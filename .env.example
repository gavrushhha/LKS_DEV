# --- приложение
APP_ENV=dev
APP_NAME=lks-education
LOG_LEVEL=INFO

# --- БД ЛКС (журнал, ведомости)
LKS_DB_DSN=postgresql+asyncpg://lks:lks@localhost:5432/lks

# --- источник расписания: Тандем (ТОЛЬКО ЧТЕНИЕ)
# mode: replica — прямое чтение из реплики, snapshot — из локального снимка
TANDEM_MODE=replica
TANDEM_DB_DSN=postgresql+asyncpg://readonly:CHANGE_ME@tandem-replica:5432/tandem
TANDEM_POOL_MIN=1
TANDEM_POOL_MAX=10
TANDEM_STATEMENT_TIMEOUT_MS=5000
TANDEM_BUDGET_RPM=60

# --- Redis (кэш расписания, ETag, блокировки)
REDIS_DSN=redis://localhost:6379/0
SCHEDULE_CACHE_TTL_SECONDS=60

# --- платформенные сервисы
IDENTITY_JWKS_URL=http://identity.local/.well-known/jwks.json
ACCESS_BASE_URL=http://access.local
FILES_BASE_URL=http://files.local
